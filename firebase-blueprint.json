{
  "entities": {
    "User": {
      "title": "User",
      "description": "Usuário autenticado do sistema de coleta",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "username": { "type": "string" },
        "email": { "type": "string" },
        "isAdmin": { "type": "boolean" },
        "isApproved": { "type": "boolean" },
        "allowedGroups": { "type": "array", "items": { "type": "string" } },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["username", "email", "isAdmin", "isApproved"]
    },
    "ColetaLista": {
      "title": "ColetaLista",
      "description": "Metadados de uma lista de coleta de pacotes",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "nome": { "type": "string" },
        "tipo": { "type": "string", "enum": ["comum", "grupos"] },
        "rota": { "type": "string" },
        "data": { "type": "string" },
        "responsavel": { "type": "string" },
        "status": { "type": "string", "enum": ["em_andamento", "finalizada"] },
        "saidaPadrao": { "type": "string" },
        "motivoPadrao": { "type": "string" },
        "totalItens": { "type": "number" },
        "totalValidados": { "type": "number" },
        "saidasCount": { "type": "object" },
        "motivosCount": { "type": "object" },
        "rotasCount": { "type": "object" },
        "bipsPorOperador": { "type": "object" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["nome", "data", "responsavel", "status"]
    },
    "ColetaItem": {
      "title": "ColetaItem",
      "description": "Um pacote ou item individual coletado na subcoleção",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "codigo": { "type": "string" },
        "codigoClean": { "type": "string" },
        "rota": { "type": "string" },
        "saida": { "type": "string" },
        "motivo": { "type": "string" },
        "scannedAt": { "type": "string" },
        "responsavel": { "type": "string" },
        "timestamp": { "type": "number" },
        "grupoId": { "type": "string" },
        "validado": { "type": "boolean" }
      },
      "required": ["id", "codigo", "scannedAt"]
    },
    "RefugoScan": {
      "title": "RefugoScan",
      "description": "Registro de scan atômico de refugo",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "rota": { "type": "string" },
        "status": { "type": "string" },
        "foundBy": { "type": "string" },
        "scannedAt": { "type": "string" },
        "timestamp": { "type": "number" }
      },
      "required": ["id"]
    },
    "RefugoHistoricoMetrica": {
      "title": "RefugoHistoricoMetrica",
      "description": "Registro consolidado permanente de métricas e rotas encontradas no refugo",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "data": { "type": "string" },
        "dataHora": { "type": "string" },
        "timestamp": { "type": "number" },
        "responsavel": { "type": "string" },
        "totalBipados": { "type": "number" },
        "totalEncontrados": { "type": "number" },
        "totalBrancas": { "type": "number" },
        "rotasEncontradas": { "type": "object" },
        "origem": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "data", "totalBipados", "totalEncontrados", "totalBrancas"]
    },
    "RoutingRun": {
      "title": "RoutingRun",
      "description": "Fotografia de uma tentativa de roteirização de etiquetas brancas",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "cicloTentativa": { "type": "string" },
        "totalBrancas": { "type": "number" },
        "roteirizados": { "type": "number" },
        "naoRoteirizados": { "type": "number" },
        "recuperados": { "type": "number" },
        "continuamFalhando": { "type": "number" },
        "createdAt": { "type": "string" },
        "timestamp": { "type": "number" },
        "observacao": { "type": "string" }
      },
      "required": ["id", "cicloTentativa", "totalBrancas", "roteirizados", "naoRoteirizados"]
    },
    "RoutingRunItem": {
      "title": "RoutingRunItem",
      "description": "Item individual dentro de uma tentativa de roteirização",
      "type": "object",
      "properties": {
        "idPacote": { "type": "string" },
        "cicloTentativa": { "type": "string" },
        "resultado": { "type": "string", "enum": ["ROTEIRIZADO", "NAO_ROTEIRIZADO"] },
        "transicao": { "type": "string" },
        "dataBranca": { "type": "string" },
        "base": { "type": "string" },
        "cicloOrigem": { "type": "string" },
        "etapaFluxo": { "type": "string" },
        "motivoMacro": { "type": "string" },
        "detalheDescartes": { "type": "string" },
        "statusTraduzido": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["idPacote", "cicloTentativa", "resultado"]
    },
    "PackageSummary": {
      "title": "PackageSummary",
      "description": "Resumo do último estado de um pacote analisado",
      "type": "object",
      "properties": {
        "idPacote": { "type": "string" },
        "ultimoResultado": { "type": "string" },
        "ultimoCicloTentativa": { "type": "string" },
        "ultimaTransicao": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["idPacote", "ultimoResultado"]
    },
    "PackageMovimentacao": {
      "title": "PackageMovimentacao",
      "description": "Evento histórico imutável na linha do tempo do pacote",
      "type": "object",
      "properties": {
        "cicloTentativa": { "type": "string" },
        "resultado": { "type": "string" },
        "transicao": { "type": "string" },
        "motivoMacro": { "type": "string" },
        "detalheDescartes": { "type": "string" },
        "statusTraduzido": { "type": "string" },
        "dataBranca": { "type": "string" },
        "dataRegistro": { "type": "string" },
        "runId": { "type": "string" }
      },
      "required": ["cicloTentativa", "resultado", "dataRegistro"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "Coleção de contas de usuário e controle de permissões"
    },
    "/coleta_listas/{listaId}": {
      "schema": "ColetaLista",
      "description": "Coleção de metadados das listas de coleta"
    },
    "/coleta_listas/{listaId}/itens/{itemId}": {
      "schema": "ColetaItem",
      "description": "Subcoleção de pacotes individuais da lista de coleta com ID determinístico"
    },
    "/refugo_scans_items/{scanId}": {
      "schema": "RefugoScan",
      "description": "Coleção de scans atômicos de pacotes de refugo"
    },
    "/refugo_historico_metricas/{registroId}": {
      "schema": "RefugoHistoricoMetrica",
      "description": "Coleção permanente de métricas e rotas encontradas no Refugo mesmo após limpeza da mesa"
    },
    "/routing_runs/{runId}": {
      "schema": "RoutingRun",
      "description": "Fotografias e sumários das tentativas de roteirização"
    },
    "/routing_runs/{runId}/items/{itemId}": {
      "schema": "RoutingRunItem",
      "description": "Itens individuais processados em uma corrida de roteirização"
    },
    "/packages/{packageId}": {
      "schema": "PackageSummary",
      "description": "Estado consolidado mais recente de cada pacote"
    },
    "/packages/{packageId}/movimentacoes/{movId}": {
      "schema": "PackageMovimentacao",
      "description": "Subcoleção cronológica de histórico de tentativas de um pacote"
    }
  }
}
