rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Coleção de Usuários e Perfis
    match /users/{userId} {
      allow read, write: if true;
    }
    
    // Coleção principal de Listas de Coleta (Metadados leves)
    match /coleta_listas/{listaId} {
      allow read, write: if true;
      
      // Subcoleção de Itens e Pacotes Individuais
      // Cada bip opera estritamente nesta subcoleção com IDs determinísticos
      match /itens/{itemId} {
        allow read, write: if true;
      }
    }

    // Scans de refugo atômicos
    match /refugo_scans_items/{scanId} {
      allow read, write: if true;
    }

    // Coleções legadas de compatibilidade
    match /refugo/{docId} {
      allow read, write: if true;
    }
    match /coletor/{docId} {
      allow read, write: if true;
    }
  }
}
